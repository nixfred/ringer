[Unit]
Description=Ringer core: iPhone screen, touch and clipboard server (pymobiledevice3 + keyboard-release patch, loopback only)
After=usbmuxd.service

[Service]
Nice=10
# No iPhone on USB: skip quietly instead of failing and restarting forever.
ExecCondition=/bin/sh -c 'grep -qs "^05ac$" /sys/bus/usb/devices/*/idVendor'
# The password never leaves ~/.config/ringer (mode 600). $$ is systemd's escape for a literal $.
ExecStart=/bin/sh -c 'exec %h/.local/share/uv/tools/pymobiledevice3/bin/python %h/Projects/iphone.control.in.omarchy/engine/ringer-core.py developer core-device display serve-web --bind 127.0.0.1 --http-port 18091 --password "$$(cat %h/.config/ringer/vnc.pw)"'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
