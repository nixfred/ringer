#!/usr/bin/env bash
# Open the Ringer iPhone window: just the phone, floating, sized to its aspect ratio.
# Starts the user services if they are not running. Never types into the desktop.
#
# Two modes:
#  - local (default): ringer-core runs on this host and needs the iPhone on USB.
#  - remote: ~/.config/ringer/upstream holds the URL of a ringer-core running on another host (fnix, where
#    Apple's own stack reaches the phone over Wi-Fi). No cable and no local core, only that URL must answer.
set -euo pipefail
cfg="$HOME/.config/ringer"
W=${RINGER_W:-470} H=${RINGER_H:-1005}
UP=$(cat "$cfg/upstream" 2>/dev/null || true)

if [ -n "$UP" ]; then
  RHOST=$(cat "$cfg/remote-host" 2>/dev/null || true)
  up_ok() { curl -fs -m 6 -u "ringer:$(cat "$cfg/vnc.pw")" "$UP/codec" >/dev/null 2>&1; }
  if ! up_ok && [ -n "$RHOST" ]; then
    # The engine is off (it is only on while Ringer is). Start it on the Mac and wait for the phone stream.
    ssh -o BatchMode=yes -o ConnectTimeout=8 "$RHOST" 'launchctl bootstrap gui/$(id -u) ~/.ringer/com.nixfred.ringer-core.plist 2>/dev/null || launchctl kickstart gui/$(id -u)/com.nixfred.ringer-core' >/dev/null 2>&1 || true
    for _ in $(seq 1 30); do up_ok && break; sleep 2; done
  fi
  up_ok || { echo "The Ringer engine at $UP did not answer. Is $RHOST awake and the phone on its Wi-Fi?" >&2; exit 3; }
  systemctl --user start ringer-view.service ringer-clip.service ringer-awake.service
else
  phone=0
  for d in /sys/bus/usb/devices/[0-9]*; do
    [ "$(cat "$d/idVendor" 2>/dev/null)" = 05ac ] && grep -qi iphone "$d/product" 2>/dev/null && phone=1
  done
  [ "$phone" = 1 ] || { echo "No iPhone on USB. Plug it in, unlock it and tap Trust." >&2; exit 3; }
  systemctl --user start ringer-core.service ringer-view.service ringer-clip.service
  for _ in $(seq 1 120); do ss -ltn | grep -q '127.0.0.1:18091' && break; sleep 0.25; done
  ss -ltn | grep -q '127.0.0.1:18091' || { echo "The phone link did not come up (journalctl --user -u ringer-core)." >&2; exit 4; }
fi

for _ in $(seq 1 40); do ss -ltn | grep -q '127.0.0.1:18092' && break; sleep 0.25; done
ss -ltn | grep -q '127.0.0.1:18092' || { echo "ringer-view did not start: journalctl --user -u ringer-view" >&2; exit 1; }
brave --app="http://127.0.0.1:18092/?k=$(cat "$cfg/token")" --window-size="$W,$H" >/dev/null 2>&1 &
addr=""
for _ in $(seq 1 40); do
  addr=$(hyprctl clients -j | jq -r '[.[]|select(.title=="Ringer")][0].address // empty')
  [ -n "$addr" ] && break; sleep 0.25
done
[ -n "$addr" ] || { echo "Ringer window did not appear" >&2; exit 1; }
hyprctl dispatch "hl.dsp.window.float({ action = \"set\", window = \"address:$addr\" })"
hyprctl dispatch "hl.dsp.window.resize({ x = $W, y = $H, relative = false, window = \"address:$addr\" })"
# Put it back where it was last seen (the plugin helper records the position while the window is open).
# Hyprland places a new window a moment after it maps, so move, check, and retry a couple of times.
if read -r PX PY < "$cfg/window.pos" 2>/dev/null && [ -n "${PX:-}" ] && [ -n "${PY:-}" ]; then
  for _ in 1 2 3 4; do
    sleep 0.4
    hyprctl dispatch "hl.dsp.window.move({ x = $PX, y = $PY, window = \"address:$addr\" })" >/dev/null || true
    sleep 0.2
    now=$(hyprctl clients -j | jq -r --arg a "$addr" '.[]|select(.address==$a)|"\(.at[0]) \(.at[1])"')
    [ "$now" = "$PX $PY" ] && break
  done
fi
