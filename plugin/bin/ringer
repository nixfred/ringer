#!/usr/bin/env bash
# ringer: status / open / stop for the Ringer iPhone window. Prints one JSON object. bash + jq only
# (a plugin must not assume bun; see engine/ for the pieces that do).
set -uo pipefail
ENGINE="${RINGER_ENGINE:-$HOME/Projects/iphone.control.in.omarchy/engine}"

phone_usb() {   # prints the USB product name of an attached iPhone (Apple vendor 05ac)
  local d
  for d in /sys/bus/usb/devices/[0-9]*; do
    [ "$(cat "$d/idVendor" 2>/dev/null)" = 05ac ] && grep -qi iphone "$d/product" 2>/dev/null && { cat "$d/product"; return 0; }
  done
  return 1
}
active() { systemctl --user is-active --quiet "$1" 2>/dev/null && echo true || echo false; }
window_pos() { hyprctl clients -j 2>/dev/null | jq -r '[.[]|select(.title=="Ringer")][0] | if . then "\(.at[0]) \(.at[1])" else empty end' 2>/dev/null; }
window_addr() { hyprctl clients -j 2>/dev/null | jq -r '[.[]|select(.title=="Ringer")][0].address // empty' 2>/dev/null; }

CFG="$HOME/.config/ringer"
UP=$(cat "$CFG/upstream" 2>/dev/null || true)

status() {
  local usb=false name="" eng=false core fnix=true remote=false pos
  core=$(active ringer-core)
  pos=$(window_pos); [ -n "$pos" ] && { [ "$(cat "$CFG/window.pos" 2>/dev/null)" = "$pos" ] || printf '%s\n' "$pos" > "$CFG/window.pos"; }
  if [ -n "$UP" ]; then
    remote=true
    code=$(curl -s -m 3 -o /dev/null -w '%{http_code}' "$UP/" 2>/dev/null || true)
    case "$code" in 200|401) fnix=true;; *) fnix=false;; esac
    # The core runs on another host (fnix): the phone is "attached" when that core answers.
    if curl -fs -m 4 -u "ringer:$(cat "$CFG/vnc.pw" 2>/dev/null)" "$UP/codec" >/dev/null 2>&1; then
      usb=true; core=true; name="iPhone via ${UP#http://}"
    else
      core=false
    fi
  else
    name=$(phone_usb) && usb=true
  fi
  [ -x "$ENGINE/ringer-view-open" ] && eng=true
  jq -n --argjson usb "$usb" --arg phone "$name" --argjson core "$core" \
        --argjson view "$(active ringer-view)" --arg win "$(window_addr)" --argjson engine "$eng" --argjson fnix "$fnix" --argjson remote "$remote" \
    '{ok:true, usb:$usb, phone:$phone, core:$core, view:$view, window:($win!=""), engine:$engine, fnix:$fnix, remote:$remote}'
}

case "${1:-status}" in
  status) status ;;
  open)
    a=$(window_addr)
    if [ -n "$a" ]; then
      hyprctl dispatch "hl.dsp.focus({ window = \"address:$a\" })" >/dev/null 2>&1
    elif [ -x "$ENGINE/ringer-view-open" ]; then
      err=$("$ENGINE/ringer-view-open" 2>&1 >/dev/null) || { jq -n --arg e "${err:-ringer-view-open failed (journalctl --user -u ringer-view)}" '{ok:false,error:$e}'; exit 0; }
    else
      jq -n --arg e "engine not found at $ENGINE" '{ok:false,error:$e}'; exit 0
    fi
    status ;;
  stop)
    a=$(window_addr)
    [ -n "$a" ] && hyprctl dispatch "hl.dsp.window.close({ window = \"address:$a\" })" >/dev/null 2>&1
    systemctl --user stop ringer-awake.service ringer-clip.service ringer-view.service ringer-core.service >/dev/null 2>&1
    status ;;
  *) jq -n --arg e "usage: ringer status|open|stop" '{ok:false,error:$e}'; exit 2 ;;
esac
